{
  "mcpServers": {
    "photocraft": {
      "command": "photocraft-cli",
      "args": ["mcp", "--bridge", "127.0.0.1:7878", "--control-token-file", "${HOME}/.config/photocraft/control.token"]
    },
    "vectorcraft": {
      "command": "vectorcraft-cli",
      "args": ["mcp", "--connect", "127.0.0.1:7979"]
    },
    "designcraft": {
      "command": "designcraft-cli",
      "args": ["mcp", "--connect", "7980"]
    },
    "effectcraft": {
      "command": "effectcraft-cli",
      "args": ["mcp", "--bridge", "9877"]
    }
  }
}
